# COPY TO .env AND FILL IN. .env IS GITIGNORED — KEEP REAL PASSWORDS OUT OF THE REPO.
# EVERY VARIABLE IS OPTIONAL: WITH NO .env AT ALL, DEVELOPMENT RUNS ON SQLite.

# WHICH DATABASE DEVELOPMENT USES: sqlite (DEFAULT) OR mariadb.
# PRODUCTION IGNORES THIS AND ALWAYS USES MariaDB.
DJANGO_DB=sqlite

# ONLY READ WHEN THE BACKEND IS mariadb. CREATE THE DATABASE AND USER WITH
# `bash scripts/create_dev_db.sh`, WHICH READS DB_NAME/DB_USER/DB_PASSWORD FROM
# THIS FILE.
DB_NAME=sherlog
DB_USER=sherlog
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
